# Frontend dev-server settings — copy to web/.env and adjust as needed.
# These default to the values below when unset, so an empty file is fine.

# Port the Vite dev server listens on (default 3100; pass --port to override).
VITE_DEV_PORT=3100

# Backend the Vite dev proxy forwards /v1 to (default http://localhost:8100).
# air serves the API on 8100 (`air` uses .air.toml → `serve --port 8100`).
VITE_API_PROXY_TARGET=http://localhost:8100

# Optional: absolute base prepended to /v1 paths by the API client. Leave unset
# in dev (the vite proxy handles it); set when building for a separate origin.
# VITE_API_BASE_URL=